---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import kickpostHomepage from '../assets/kickpost-homepage.png';
import kickpostMobile from '../assets/kickpost-mobile.png';
import esportsDesktop from '../assets/esports-desktop.png';
import esportsMobile from '../assets/esports-mobile.png';
import ritoPreview from '../assets/rito-store.png';

const projects = [
  { id: 'kickpost', title: 'KickPost', category: 'EXPERIENCE', caption: 'FULL-STACK DEVELOPMENT', stack: 'REACT / NODE.JS / POSTGRESQL / AWS', role: 'Full-Stack Developer Intern', date: 'JUL 2026 — PRESENT', description: 'I work across the product: faster database queries, real-time updates, and smoother deployments.', detail: 'From PostgreSQL to React, with a focus on making the everyday experience better.', url: 'https://www.kickpost.io/', link: 'Visit KickPost', secondary: '/resume.pdf', secondaryLabel: 'My résumé' },
  { id: 'esports', title: 'Esports Analytics', category: 'PROJECT', caption: 'RESEARCH PLATFORM', stack: 'REACT / TYPESCRIPT / EFFECT / CLOUDFLARE', role: 'A closer look at the game.', date: 'LOL & VALORANT', description: 'Player stats, explainable models, and match research, together in one workspace.', detail: 'Compare teams, explore historical performance, and save research with outcome tracking.', url: 'https://esports-prop-research.pages.dev', link: 'Open the platform', secondary: undefined, secondaryLabel: undefined },
  { id: 'rito', title: 'RitoEsports Tracker', category: 'PROJECT', caption: 'CHROME EXTENSION', stack: 'TYPESCRIPT / EFFECT / AWS', role: 'Your next match, one click away.', date: 'JUN 2025 — PRESENT', description: 'Esports schedules, streams, and live alerts, right in your browser.', detail: 'An Effect-based AWS pipeline keeps LoL and VALORANT schedules up to date, with cached results when a refresh fails.', url: 'https://chromewebstore.google.com/detail/ritoesports-tracker/eldpjindebiejpnpclddndcnmefbbooi', link: 'View extension', secondary: undefined, secondaryLabel: undefined },
  { id: 'logs', title: 'Log Aggregation', category: 'PROJECT', caption: 'DISTRIBUTED SYSTEMS', stack: 'C++17 / TYPESCRIPT / PYTHON / SQLITE', role: 'From scattered logs to answers.', date: '5 CONNECTED SERVICES', description: 'A distributed log platform with real-time search, anomaly detection, and a monitoring dashboard.', detail: 'A C++ file-tail agent, persistent queues, and SQLite full-text search keep the whole flow connected.', url: 'https://github.com/gchen0002/Log-Aggregation-System', link: 'Explore the code', secondary: undefined, secondaryLabel: undefined },
] as const;
---
<Layout>
  <a class="skip-link" href="#work">Skip to work</a>
  <main class="portfolio">
    <header class="topbar">
      <nav aria-label="Personal links">
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Résumé <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/gchen0002" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <section class="intro" aria-labelledby="greeting">
      <div class="intro-copy">
        <h1 id="greeting">Hello <span class="wave" role="img" aria-label="waving hand">👋</span> I’m Guanying</h1>
        <p>Junior at Cal State LA</p>
      </div>
      <div class="local-clock" aria-label="Current time in Los Angeles">
        <div class="clock-face" aria-hidden="true"><span class="clock-pair"><span class="clock-digit"><span id="clock-digit-0">-</span></span><span class="clock-digit"><span id="clock-digit-1">-</span></span></span><span class="clock-colon">:</span><span class="clock-pair"><span class="clock-digit"><span id="clock-digit-2">-</span></span><span class="clock-digit"><span id="clock-digit-3">-</span></span></span><span class="clock-period" id="clock-period">PT</span></div>
        <span class="clock-label">LOS ANGELES</span>
        <span class="sr-only" id="clock-readable">Los Angeles local time</span>
      </div>
    </section>

    <section class="deck" id="work" aria-label="Experience and selected projects">
      {projects.map((project, index) => (
        <article class={`panel panel-${project.id}`} style={`--index: ${index}; --after-active: ${index > 0 ? 1 : 0}`} data-panel={index} data-active={index === 0 ? 'true' : 'false'}>
          <h2 class="panel-heading">
            <button class="panel-toggle" id={`toggle-${project.id}`} type="button" aria-label={`${project.title} — ${project.category.toLowerCase()}`} aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`content-${project.id}`}>
              <span class="panel-number mono" aria-hidden="true">0{index + 1}</span>
              <span class="panel-category mono" aria-hidden="true">/ {project.category}</span>
              <span class="rail-title" aria-hidden="true">{project.title}</span>
              <span class="rail-bottom" aria-hidden="true"><ProjectIcon kind={project.id} /><span class="rail-caption mono">{project.caption}</span></span>
            </button>
          </h2>

          <div class="panel-content" id={`content-${project.id}`} role="region" aria-labelledby={`toggle-${project.id}`} aria-hidden={index !== 0 ? 'true' : 'false'}>
            <div class="panel-copy">
              <div>
                <h3>{project.title}</h3>
                <p class="project-role">{project.role}</p>
                <p class="project-date mono">{project.date}</p>
              </div>
              <div class="project-description"><span class="short-rule" aria-hidden="true"></span><p>{project.description}</p><p class="project-detail">{project.detail}</p></div>
              <div class="project-links"><a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">{project.link}<span aria-hidden="true">↗</span></a>{project.secondary && <a class="secondary-link" href={project.secondary} target="_blank" rel="noopener noreferrer">{project.secondaryLabel} <span aria-hidden="true">↗</span></a>}</div>
            </div>

            <div class={`preview preview-${project.id}`}>
              {project.id === 'kickpost' && <a class="website-preview" href="https://www.kickpost.io/" target="_blank" rel="noopener noreferrer" aria-label="Preview KickPost’s website — opens in a new tab"><div class="website-toolbar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>kickpost.io</span><span aria-hidden="true">↗</span></div><div class="website-capture"><Image class="website-desktop" src={kickpostHomepage} width={960} format="webp" alt="KickPost homepage with its partner community and sales platform" loading="eager" /><Image class="website-mobile" src={kickpostMobile} width={390} format="webp" alt="KickPost mobile homepage" loading="lazy" /></div><span class="website-caption"><span>Explore KickPost</span><span aria-hidden="true">↗</span></span></a>}
              {project.id === 'esports' && <a class="website-preview" href={project.url} target="_blank" rel="noopener noreferrer" aria-label="Open Esports Analytics — preview of the research platform"><div class="website-toolbar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>Esports Analytics</span><span aria-hidden="true">↗</span></div><div class="website-capture"><Image class="website-desktop" src={esportsDesktop} width={1100} format="webp" alt="Esports Analytics showing the live match board, player research, and historical performance chart" loading="lazy" /><Image class="website-mobile" src={esportsMobile} width={390} format="webp" alt="Esports Analytics mobile player research screen" loading="lazy" /></div><span class="website-caption"><span>Explore the platform</span><span aria-hidden="true">↗</span></span></a>}
              {project.id === 'rito' && <a class="website-preview" href={project.url} target="_blank" rel="noopener noreferrer" aria-label="View RitoEsports Tracker in the Chrome Web Store"><div class="website-toolbar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>RitoEsports Tracker</span><span aria-hidden="true">↗</span></div><div class="website-capture rito-capture"><Image src={ritoPreview} width={1100} format="webp" alt="RitoEsports Tracker’s published screenshot showing live matches, upcoming schedules, and stream links" loading="lazy" /></div><span class="website-caption"><span>View extension</span><span aria-hidden="true">↗</span></span></a>}
              {project.id === 'logs' && <div class="logs-preview" aria-label="Illustration of the log aggregation architecture"><div class="mini-heading"><span class="mini-mark">›_</span><span>Log pipeline</span></div><div class="log-flow"><span>TAIL</span><span>→</span><span>QUEUE</span><span>→</span><span>STORE</span></div><div class="log-lines mono"><p><span class="log-time">01</span><b>agent</b> watch file changes</p><p><span class="log-time">02</span><b>queue</b> batch & persist</p><p><span class="log-time">03</span><b>search</b> index with FTS5</p><p><span class="log-time">04</span><b>detect</b> find anomalies</p></div><div class="log-summary"><strong>Many sources.<br/>One place to look.</strong><span class="mono">C++17 → SQLITE → PYTHON</span></div></div>}
            </div>
            <p class="panel-stack mono">{project.stack}</p>
          </div>
        </article>
      ))}
    </section>
    <noscript><p class="no-script-links">Explore: {projects.map(project => <a href={project.url}>{project.title} ↗</a>)}</p></noscript>
  </main>
  <script src="../scripts/portfolio.ts"></script>
</Layout>
