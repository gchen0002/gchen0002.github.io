---
import '../styles/global.css';
import '@fontsource-variable/dm-sans';
import '@fontsource/ibm-plex-mono/latin-400.css';
const { title = 'Guanying Chen — Portfolio' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0d0e" />
    <meta name="description" content="Hi, I'm Guanying, a junior at Cal State LA and Full-Stack Developer Intern at KickPost. Explore my work in esports, browser extensions, and distributed systems." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
