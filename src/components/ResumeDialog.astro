---
interface Props { pdfUrl: string; }
const { pdfUrl } = Astro.props;
---
<dialog class="resume-dialog" data-resume-dialog data-pdf-url={pdfUrl} aria-labelledby="resume-title">
  <header class="resume-toolbar">
    <h2 id="resume-title">Guanying Chen · Résumé</h2>
    <div class="resume-controls">
      <button type="button" data-resume-zoom="-1" aria-label="Zoom out">−</button>
      <output data-resume-scale aria-label="Zoom level">100%</output>
      <button type="button" data-resume-zoom="1" aria-label="Zoom in">+</button>
      <button class="resume-close" type="button" data-resume-close aria-label="Close résumé" autofocus>×</button>
    </div>
  </header>
  <div class="resume-scroller" data-resume-scroller>
    <div class="resume-feedback">
      <p data-resume-status role="status">Loading résumé…</p>
      <button type="button" data-resume-retry hidden>Try again</button>
    </div>
    <div class="resume-pages" data-resume-pages></div>
  </div>
</dialog>

<style is:global>
  .resume-dialog { width: min(940px, calc(100vw - 32px)); height: calc(100dvh - 48px); max-width: none; max-height: none; margin: auto; padding: 0; border: 1px solid #55515d; border-radius: 16px; background: #18171b; color: #f5f3ee; box-shadow: 0 24px 90px #0008; overflow: hidden; }
  .resume-dialog[open] { display: flex; flex-direction: column; }
  .resume-dialog::backdrop { background: #08070bc9; }
  body:has(.resume-dialog[open]) { overflow: hidden; }
  .resume-toolbar { display: flex; align-items: center; justify-content: space-between; flex: none; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #35313b; }
  .resume-toolbar h2 { font-size: 14px; font-weight: 550; }
  .resume-controls { display: flex; align-items: center; gap: 6px; }
  .resume-controls button { display: grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 1px solid #47424e; border-radius: 8px; background: #25222b; font: 20px/1 sans-serif; }
  .resume-controls button:disabled { opacity: .35; cursor: default; }
  .resume-controls output { min-width: 44px; text-align: center; font-size: 12px; font-variant-numeric: tabular-nums; }
  .resume-controls .resume-close { margin-left: 10px; font-size: 25px; }
  .resume-scroller { flex: 1; min-height: 0; overflow: auto; padding: 20px; overscroll-behavior: contain; }
  .resume-feedback { text-align: center; font-size: 14px; color: #c9c0d5; }
  .resume-feedback p:empty { display: none; }
  .resume-feedback button { border: 1px solid #766689; border-radius: 8px; padding: 8px 14px; background: #292230; margin: 12px; }
  .resume-pages { display: flex; flex-direction: column; align-items: start; gap: 16px; width: max-content; min-width: 100%; }
  .resume-page { position: relative; flex: none; margin-inline: auto; background: #fff; color: #111; box-shadow: 0 3px 20px #0003; }
  .resume-page canvas { display: block; max-width: none; }
  .resume-text { position: absolute; inset: 0; overflow: clip; line-height: 1; letter-spacing: normal; word-spacing: normal; text-align: initial; text-size-adjust: none; forced-color-adjust: none; transform-origin: 0 0; --min-font-size: 1; --text-scale-factor: calc(var(--total-scale-factor) * var(--min-font-size)); --min-font-size-inv: calc(1 / var(--min-font-size)); }
  .resume-text :is(span, br) { position: absolute; color: transparent; white-space: pre; cursor: text; transform-origin: 0 0; user-select: text; }
  .resume-text > :not(.markedContent), .resume-text .markedContent span:not(.markedContent) { --font-height: 0; --scale-x: 1; --rotate: 0deg; font-size: calc(var(--text-scale-factor) * var(--font-height)); transform: rotate(var(--rotate)) scaleX(var(--scale-x)) scale(var(--min-font-size-inv)); }
  .resume-text .markedContent { display: contents; }
  .resume-text ::selection { background: #8664ed55; color: transparent; }
  .resume-page-link { position: absolute; display: block; }
  .resume-page-link:hover { background: #8664ed22; }
  @media (max-width: 600px) {
    .resume-dialog { width: calc(100vw - 12px); height: calc(100dvh - 16px); border-radius: 12px; }
    .resume-toolbar { padding: 10px; gap: 8px; flex-wrap: wrap; }
    .resume-toolbar h2 { font-size: 12px; }
    .resume-controls { gap: 3px; }
    .resume-controls button { width: 30px; height: 32px; }
    .resume-controls .resume-close { margin-left: 3px; }
    .resume-scroller { padding: 10px; }
  }
</style>
