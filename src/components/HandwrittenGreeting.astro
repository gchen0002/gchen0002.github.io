---
const words = [
  { text: 'Hello', start: 0 },
  { text: 'I’m', start: 6 },
  { text: 'Guanying', start: 9 },
];
---
<h1 id="greeting">
  <span class="sr-only">Hello, I’m Guanying</span>
  <span class="greeting-writing" aria-hidden="true">{words.map((word, index) => <><span class="handwritten-word">{Array.from(word.text).map((letter, position) => <span class="handwritten-letter" data-letter={letter} style={`--letter-delay: ${500 + (word.start + position) * 90}ms`}>{letter}</span>)}</span>{index === 0 && <> <span class="wave">👋</span></>}{index < words.length - 1 && ' '}</>)}</span>
</h1>
